# Binaries & build output
/bin/
/dist/
/tea-dash
*.exe
*.test
*.out
coverage.*

# Go workspace files
go.work
go.work.sum

# Editors / OS
.DS_Store
.idea/
.vscode/
*.swp
docs/demo.mp4
.mcp.json

# Local, potentially token-bearing config — never commit (config lives in
# ~/.config/tea-dash/; these guard against an accidental in-repo copy).
config.yml
*.local.yml
.env
# ...but the GitHub issue-template chooser config is not one of those: the bare
# `config.yml` rule above matches at any depth, which would silently drop it.
!.github/ISSUE_TEMPLATE/config.yml
